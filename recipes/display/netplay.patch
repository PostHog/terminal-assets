+// GNU General Public License for more details.
+//
+// DESCRIPTION:
+//     Text lobby for network games in the PostHog browser terminal.
+//     It replaces the textscreen GUI in net_gui.c and draws on the
+//     active virtual console before the game switches to graphics.
+//
+
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <termios.h>
+#include <unistd.h>
+
+#include "doomtype.h"
+#include "i_system.h"
+#include "i_timer.h"
+#include "m_argv.h"
+#include "m_misc.h"
+#include "net_client.h"
+#include "net_gui.h"
+#include "net_lobby.h"
+#include "net_server.h"
+
+#define CONSOLE_DEVICE "/dev/tty0"
+#define KEY_ESCAPE 27
+
+static int console_fd = -1;
+
+static void OpenConsole(void)
+{
+    if (console_fd < 0)
+    {
+        console_fd = open(CONSOLE_DEVICE, O_RDWR | O_NOCTTY | O_NONBLOCK);
+    }
+}
+
+void NET_LobbyPrint(const char *format, ...)
+{
+    char buffer[2048];
+    va_list args;
+
+    OpenConsole();
+
+    va_start(args, format);
+    M_vsnprintf(buffer, sizeof(buffer), format, args);
+    va_end(args);
+
+    if (console_fd >= 0)
+    {
+        if (write(console_fd, buffer, strlen(buffer)) < 0)
+        {
+            // The lobby is informational; the game continues without it.
+        }
+    }
+}
+
+static void DrawLobby(char *screen, size_t screen_len)
+{
+    char line[128];
+    int i;
+
+    M_StringCopy(screen, "\033[H\033[2JPostHog deathmatch\n\n", screen_len);
+
+    if (net_serial_room[0] != '\0')
+    {
+        M_snprintf(line, sizeof(line),
+                   "Room code: %s\nTeammates join with: doom -connect %s\n\n",
+                   net_serial_room, net_serial_room);
+        M_StringConcat(screen, line, screen_len);
+    }
+
+    if (!net_client_received_wait_data)
+    {
+        M_StringConcat(screen, "Connecting...\n", screen_len);
+        return;
+    }
+
+    M_snprintf(line, sizeof(line), "Players (%i of %i):\n",
+               net_client_wait_data.num_players,
+               net_client_wait_data.max_players);
+    M_StringConcat(screen, line, screen_len);
+
+    for (i = 0; i < net_client_wait_data.num_players; ++i)
+    {
+        M_snprintf(line, sizeof(line), "  %i. %s%s\n", i + 1,
+                   net_client_wait_data.player_names[i],
+                   i == net_client_wait_data.consoleplayer ? " (you)" : "");
+        M_StringConcat(screen, line, screen_len);
+    }
+
+    if (net_client_wait_data.is_controller)
+    {
+        M_StringConcat(screen,
+                       "\nPress Space to start. Press Escape to leave.\n",
+                       screen_len);
+    }
+    else
+    {
+        M_StringConcat(screen,
+                       "\nWaiting for the host to start. Press Escape to leave.\n",
+                       screen_len);
+    }
+}
+
+void NET_WaitForLaunch(void)
+{
+    struct termios old_term;
+    struct termios term;
+    boolean have_term = false;
+    boolean launched = false;
+    char screen[2048];
+    char drawn[2048] = "";
+    byte keys[16];
+    int expected_nodes = 0;
+    int i;
+
+    //!
+    // @category net
+    // @arg <n>
+    //
+    // Autostart the netgame when n nodes (clients) have joined the server.
+    //
+
+    i = M_CheckParmWithArgs("-nodes", 1);
+
+    if (i > 0)
+    {
+        expected_nodes = atoi(myargv[i + 1]);
+    }
+
+    OpenConsole();
+
+    if (console_fd >= 0 && tcgetattr(console_fd, &old_term) == 0)
+    {
+        term = old_term;
+        term.c_lflag &= ~(ICANON | ECHO);
+        term.c_cc[VMIN] = 0;
+        term.c_cc[VTIME] = 0;
+        have_term = tcsetattr(console_fd, TCSANOW, &term) == 0;
+    }
+
+    while (net_waiting_for_launch)
+    {
+        ssize_t key_count = console_fd >= 0
+                          ? read(console_fd, keys, sizeof(keys)) : 0;
+        boolean start = false;
+
+        for (i = 0; i < key_count; ++i)
+        {
+            if (keys[i] == ' ' || keys[i] == '\n' || keys[i] == '\r')
+            {
+                start = true;
+            }
+            // Arrow keys also begin with Escape, so only a lone Escape quits.
+            else if (keys[i] == KEY_ESCAPE && key_count == 1)
+            {
+                if (have_term)
+                {
+                    tcsetattr(console_fd, TCSANOW, &old_term);
+                }
+                I_Quit();
+            }
+        }
+
+        if (net_client_received_wait_data
+         && net_client_wait_data.is_controller
+         && expected_nodes > 0
+         && net_client_wait_data.num_players
+          + net_client_wait_data.num_drones >= expected_nodes)
+        {
+            start = true;
+        }
+
+        if (start && !launched
+         && net_client_received_wait_data
+         && net_client_wait_data.is_controller)
+        {
+            NET_CL_LaunchGame();
+            launched = true;
+        }
+
+        DrawLobby(screen, sizeof(screen));
+
+        if (strcmp(screen, drawn))
+        {
+            NET_LobbyPrint("%s", screen);
+            M_StringCopy(drawn, screen, sizeof(drawn));
+        }
+
+        NET_CL_Run();
+        NET_SV_Run();
+
+        if (!net_client_connected)
+        {
+            I_Error("Lost connection to the deathmatch host.");
+        }
+
+        I_Sleep(50);
+    }
+
+    if (have_term)
+    {
+        tcsetattr(console_fd, TCSANOW, &old_term);
+    }
+
+    NET_LobbyPrint("\033[H\033[2JStarting the deathmatch...\n");
+    NET_Serial_Launched();
+}
