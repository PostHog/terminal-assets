--- a/fbdoom/net_serial.c
+++ b/fbdoom/net_serial.c
@@ -0,0 +1,412 @@
+//
+// Copyright(C) 2026 PostHog
+//
+// This program is free software; you can redistribute it and/or
+// modify it under the terms of the GNU General Public License
+// as published by the Free Software Foundation; either version 2
+// of the License, or (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// DESCRIPTION:
+//     Network module for the PostHog browser terminal. The guest has no
+//     network card, so packets travel over a serial port to the browser,
+//     which relays them to the other players.
+//
+//     Each SLIP frame starts with a peer byte. Guest frames name the
+//     destination and host frames name the source. Peer 0 is the game
+//     host and peer 255 carries text control messages.
+//
+//     This replaces net_sdl.c and keeps its module name so that the
+//     Chocolate Doom call sites stay unchanged.
+//
+
+#include <ctype.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <termios.h>
+#include <unistd.h>
+
+#include "doomtype.h"
+#include "i_system.h"
+#include "i_timer.h"
+#include "m_misc.h"
+#include "net_defs.h"
+#include "net_io.h"
+#include "net_lobby.h"
+#include "net_packet.h"
+#include "net_sdl.h"
+
+#define SERIAL_DEVICE "/dev/ttyS2"
+#define CONTROL_PEER 255
+#define HOST_PEER 0
+#define MAX_FRAME 1500
+#define REPLY_TIMEOUT_MS 30000
+
+#define SLIP_END 0xc0
+#define SLIP_ESC 0xdb
+#define SLIP_ESC_END 0xdc
+#define SLIP_ESC_ESC 0xdd
+
+static int serial_fd = -1;
+static net_addr_t peers[CONTROL_PEER];
+
+static byte frame[MAX_FRAME];
+static size_t frame_len;
+static boolean frame_escaped;
+static boolean frame_overflow;
+
+static byte input[512];
+static size_t input_len;
+static size_t input_pos;
+
+static char control_reply[128];
+
+char net_serial_room[16];
+
+static boolean OpenSerial(void)
+{
+    struct termios term;
+
+    if (serial_fd >= 0)
+    {
+        return true;
+    }
+
+    serial_fd = open(SERIAL_DEVICE, O_RDWR | O_NOCTTY | O_NONBLOCK);
+
+    if (serial_fd < 0)
+    {
+        return false;
+    }
+
+    if (tcgetattr(serial_fd, &term) == 0)
+    {
+        cfmakeraw(&term);
+        tcsetattr(serial_fd, TCSANOW, &term);
+    }
+
+    // Discard frames left over from an earlier game.
+    tcflush(serial_fd, TCIOFLUSH);
+
+    return true;
+}
+
+static void WriteAll(const byte *data, size_t len)
+{
+    while (len > 0)
+    {
+        ssize_t written = write(serial_fd, data, len);
+
+        if (written < 0)
+        {
+            if (errno == EAGAIN || errno == EINTR)
+            {
+                I_Sleep(1);
+                continue;
+            }
+
+            I_Error("Lost the connection to the PostHog terminal.");
+        }
+
+        data += written;
+        len -= written;
+    }
+}
+
+static void SendFrame(byte peer, const byte *data, size_t len)
+{
+    byte encoded[MAX_FRAME * 2 + 4];
+    size_t out = 0;
+    size_t i;
+
+    encoded[out++] = SLIP_END;
+
+    for (i = 0; i <= len && out < sizeof(encoded) - 3; ++i)
+    {
+        byte value = i == 0 ? peer : data[i - 1];
+
+        if (value == SLIP_END)
+        {
+            encoded[out++] = SLIP_ESC;
+            encoded[out++] = SLIP_ESC_END;
+        }
+        else if (value == SLIP_ESC)
+        {
+            encoded[out++] = SLIP_ESC;
+            encoded[out++] = SLIP_ESC_ESC;
+        }
+        else
+        {
+            encoded[out++] = value;
+        }
+    }
+
+    encoded[out++] = SLIP_END;
+
+    WriteAll(encoded, out);
+}
+
+static void SendControl(const char *message)
+{
+    SendFrame(CONTROL_PEER, (const byte *) message, strlen(message));
+}
+
+static net_addr_t *PeerAddress(int peer)
+{
+    peers[peer].module = &net_sdl_module;
+    peers[peer].handle = &peers[peer];
+
+    return &peers[peer];
+}
+
+static int AddressPeer(net_addr_t *addr)
+{
+    return addr - peers;
+}
+
+// Reads the next complete frame into frame[] and returns its length,
+// or zero when no complete frame is waiting.
+
+static size_t ReadFrame(void)
+{
+    for (;;)
+    {
+        byte value;
+
+        if (input_pos == input_len)
+        {
+            ssize_t result = read(serial_fd, input, sizeof(input));
+
+            if (result <= 0)
+            {
+                return 0;
+            }
+
+            input_len = result;
+            input_pos = 0;
+        }
+
+        value = input[input_pos++];
+
+        if (value == SLIP_END)
+        {
+            size_t len = frame_overflow ? 0 : frame_len;
+
+            frame_len = 0;
+            frame_escaped = false;
+            frame_overflow = false;
+
+            if (len > 0)
+            {
+                return len;
+            }
+
+            continue;
+        }
+
+        if (frame_escaped)
+        {
+            value = value == SLIP_ESC_END ? SLIP_END
+                  : value == SLIP_ESC_ESC ? SLIP_ESC
+                  : value;
+            frame_escaped = false;
+        }
+        else if (value == SLIP_ESC)
+        {
+            frame_escaped = true;
+            continue;
+        }
+
+        if (frame_len < sizeof(frame))
+        {
+            frame[frame_len++] = value;
+        }
+        else
+        {
+            frame_overflow = true;
+        }
+    }
+}
+
+// Handles a control frame from the browser. Replies to the current
+// request are stored in control_reply.
+
+static void HandleControl(size_t len)
+{
+    char message[sizeof(control_reply)];
+
+    len = len - 1 < sizeof(message) - 1 ? len - 1 : sizeof(message) - 1;
+    memcpy(message, frame + 1, len);
+    message[len] = '\0';
+
+    if (!strncmp(message, "error ", 6))
+    {
+        I_Error("%s", message + 6);
+    }
+
+    M_StringCopy(control_reply, message, sizeof(control_reply));
+}
+
+// Waits for a control reply that starts with the given prefix.
+
+static void WaitForControl(const char *prefix, const char *status)
+{
+    int start = I_GetTimeMS();
+    size_t len;
+
+    control_reply[0] = '\0';
+    NET_LobbyPrint("%s\n", status);
+
+    while (strncmp(control_reply, prefix, strlen(prefix)))
+    {
+        if (I_GetTimeMS() - start > REPLY_TIMEOUT_MS)
+        {
+            I_Error("The PostHog terminal did not respond. Close Doom and try again.");
+        }
+
+        len = ReadFrame();
+
+        if (len == 0)
+        {
+            I_Sleep(10);
+        }
+        else if (frame[0] == CONTROL_PEER)
+        {
+            HandleControl(len);
+        }
+    }
+}
+
+static boolean NET_Serial_InitClient(void)
+{
+    return OpenSerial();
+}
+
+static boolean NET_Serial_InitServer(void)
+{
+    if (!OpenSerial())
+    {
+        I_Error("Multiplayer needs a newer PostHog terminal. Reload PostHog and try again.");
+    }
+
+    SendControl("host");
+    WaitForControl("room ", "Opening a deathmatch room...");
+    M_StringCopy(net_serial_room, control_reply + 5, sizeof(net_serial_room));
+
+    return true;
+}
+
+static void NET_Serial_SendPacket(net_addr_t *addr, net_packet_t *packet)
+{
+    // LAN discovery broadcasts have no meaning without a network.
+    if (addr == &net_broadcast_addr || addr->module != &net_sdl_module)
+    {
+        return;
+    }
+
+    SendFrame(AddressPeer(addr), packet->data, packet->len);
+}
+
+static boolean NET_Serial_RecvPacket(net_addr_t **addr, net_packet_t **packet)
+{
+    size_t len;
+
+    while ((len = ReadFrame()) > 0)
+    {
+        if (frame[0] == CONTROL_PEER)
+        {
+            HandleControl(len);
+            continue;
+        }
+
+        *packet = NET_NewPacket(len - 1);
+        memcpy((*packet)->data, frame + 1, len - 1);
+        (*packet)->len = len - 1;
+        *addr = PeerAddress(frame[0]);
+
+        return true;
+    }
+
+    return false;
+}
+
+static void NET_Serial_AddrToString(net_addr_t *addr, char *buffer, int buffer_len)
+{
+    int peer = AddressPeer(addr);
+
+    if (peer == HOST_PEER)
+    {
+        M_StringCopy(buffer, "host", buffer_len);
+    }
+    else
+    {
+        M_snprintf(buffer, buffer_len, "player %i", peer);
+    }
+}
+
+static void NET_Serial_FreeAddress(net_addr_t *addr)
+{
+    // Peer addresses are static.
+}
+
+// Accepts a room code from -connect. Anything else, such as the master
+// server's hostname, cannot be reached from the terminal.
+
+static net_addr_t *NET_Serial_ResolveAddress(char *address)
+{
+    char message[32];
+    size_t i;
+    size_t len = strlen(address);
+
+    if (len < 4 || len > 12)
+    {
+        return NULL;
+    }
+
+    for (i = 0; i < len; ++i)
+    {
+        if (!isalnum((unsigned char) address[i]))
+        {
+            return NULL;
+        }
+    }
+
+    if (!OpenSerial())
+    {
+        I_Error("Multiplayer needs a newer PostHog terminal. Reload PostHog and try again.");
+    }
+
+    M_snprintf(message, sizeof(message), "join %s", address);
+    SendControl(message);
+    WaitForControl("joined", "Joining the deathmatch room...");
+
+    return PeerAddress(HOST_PEER);
+}
+
+// Tells the browser that the game started, so it stops accepting players.
+
+void NET_Serial_Launched(void)
+{
+    if (serial_fd >= 0)
+    {
+        SendControl("launched");
+    }
+}
+
+net_module_t net_sdl_module =
+{
+    NET_Serial_InitClient,
+    NET_Serial_InitServer,
+    NET_Serial_SendPacket,
+    NET_Serial_RecvPacket,
+    NET_Serial_AddrToString,
+    NET_Serial_FreeAddress,
+    NET_Serial_ResolveAddress,
+};
